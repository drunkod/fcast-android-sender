// panel_chrome.slint — Reusable panel-level UI primitives.
//
// Exports:
//   PanelHeader        — header with title + single "Done" button.
//   PanelHeaderActions — header with title + free-form @children actions.
//   Card               — slintcn Card with standard app padding.
//   FormRow            — vertical label + control(s) pair.

import { Theme } from "../theme.slint";
import { Button, ButtonVariant } from "../slintcn/components/button.slint";
import { Label, LabelVariant } from "../slintcn/components/label.slint";
import {
    Card as SlintcnCard,
    CardVariant,
} from "../slintcn/components/card.slint";

// Standard header used by ~80 % of panels: title left, "Done" right.
export component PanelHeader inherits Rectangle {
    in property <string> title;
    callback close-clicked();

    height: Theme.header-height;
    background: Theme.surface-card;

    HorizontalLayout {
        padding: Theme.padding-screen;
        spacing: Theme.spacing-default;

        Label {
            text: root.title;
            horizontal-stretch: 1;
            accessible-role: text;
            accessible-label: root.title;
        }

        Button {
            text: @tr("close-panel-button" => "Done");
            variant: ButtonVariant.ghost;
            clicked => {
                root.close-clicked();
            }
        }
    }
}

// Header variant for panels with custom trailing actions (Save+Cancel, etc.).
export component PanelHeaderActions inherits Rectangle {
    in property <string> title;

    height: Theme.header-height;
    background: Theme.surface-card;

    HorizontalLayout {
        padding: Theme.padding-screen;
        spacing: Theme.spacing-default;

        Label {
            text: root.title;
            horizontal-stretch: 1;
            accessible-role: text;
            accessible-label: root.title;
        }

        @children
    }
}

// slintcn Card pads via padding-l / gap-l — pad an INNER layout, not the Card.
export component Card inherits SlintcnCard {
    in property <length> min-card-height: 56px;

    variant: CardVariant.solid;
    min-height: root.min-card-height;
    clip: true;

    VerticalLayout {
        padding-left: Theme.padding-screen;
        padding-right: Theme.padding-screen;
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: Theme.spacing-tight;
        @children
    }
}

// Vertical label + control(s) pair, 4px gap.
export component FormRow inherits VerticalLayout {
    in property <string> label;
    spacing: Theme.spacing-tight;

    Label {
        text: root.label;
        variant: LabelVariant.muted;
    }

    @children
}
