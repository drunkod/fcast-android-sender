import { Bridge } from "../bridge.slint";
import { Theme } from "../theme.slint";

// One cell inside a segmented picker bar.
component SegCell inherits Rectangle {
    in property <string> label;
    in property <bool>   active: false;
    callback clicked();

    width: 50px;
    height: 40px;
    background: transparent;

    // Active-segment highlight — inset gray fill, matches Moblin style.
    if root.active: Rectangle {
        x: 2px; y: 2px;
        width: parent.width - 4px;
        height: parent.height - 4px;
        border-radius: 6px;
        background: #ffffff99;
    }

    TouchArea { clicked => { root.clicked(); } }

    Text {
        text: root.label;
        color: #ffffff;
        font-size: 13px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// 1px vertical divider between cells.
component SegDivider inherits Rectangle {
    width: 1px;
    background: #808080;
}

// Shared segmented-pill container.
// width must be set by the caller; height is always 40px.
component SegBar inherits Rectangle {
    height: 40px;
    border-radius: 7px;
    border-width: 1px;
    border-color: #808080;
    background: #00000066;
    clip: true;
}

// Zoom bar width: 5 cells × 50px + 4 dividers × 1px = 254px.
// Camera bar uses the same width so both bars align flush right.
export global CameraHudMetrics {
    out property <length> bar-width: 5 * 50px + 4 * 1px;  // 254px
    out property <length> bar-height: 40px;
    out property <length> spacing: 6px;
    out property <length> total-height: 2 * bar-height + spacing;
}

export component CameraHud inherits Rectangle {
    background: transparent;
    width: CameraHudMetrics.bar-width;
    height: CameraHudMetrics.total-height;

    // ── VStack: zoom bar on top, camera-mode bar below ────────────────────────
    VerticalLayout {
        spacing: CameraHudMetrics.spacing;
        alignment: start;

        // Zoom presets: 0.5× 1× 2× 5× 10×
        SegBar {
            HorizontalLayout {
                spacing: 0;
                alignment: stretch;
                SegCell {
                    label: "0.5×";
                    active: Math.abs(Bridge.camera-zoom-level - 0.5) < 0.05;
                    clicked => { Bridge.camera-zoom-level = 0.5; Bridge.start-camera-rtmp-preview(); Bridge.save-cam-rtmp-config(); }
                }
                SegDivider {}
                SegCell {
                    label: "1×";
                    active: Math.abs(Bridge.camera-zoom-level - 1.0) < 0.05;
                    clicked => { Bridge.camera-zoom-level = 1.0; Bridge.start-camera-rtmp-preview(); Bridge.save-cam-rtmp-config(); }
                }
                SegDivider {}
                SegCell {
                    label: "2×";
                    active: Math.abs(Bridge.camera-zoom-level - 2.0) < 0.05;
                    clicked => { Bridge.camera-zoom-level = 2.0; Bridge.start-camera-rtmp-preview(); Bridge.save-cam-rtmp-config(); }
                }
                SegDivider {}
                SegCell {
                    label: "5×";
                    active: Math.abs(Bridge.camera-zoom-level - 5.0) < 0.05;
                    clicked => { Bridge.camera-zoom-level = 5.0; Bridge.start-camera-rtmp-preview(); Bridge.save-cam-rtmp-config(); }
                }
                SegDivider {}
                SegCell {
                    label: "10×";
                    active: Math.abs(Bridge.camera-zoom-level - 10.0) < 0.05;
                    clicked => { Bridge.camera-zoom-level = 10.0; Bridge.start-camera-rtmp-preview(); Bridge.save-cam-rtmp-config(); }
                }
            }
        }

        // Camera mode: Dual (back) | Front — same width as zoom bar.
        SegBar {
            HorizontalLayout {
                spacing: 0;
                alignment: stretch;
                // Each cell is (254 - 1) / 2 ≈ 126.5px; stretch handles the split.
                SegCell {
                    label: "Dual";
                    active: Bridge.camera-idx == 1;
                    clicked => { Bridge.camera-idx = 1; Bridge.start-camera-rtmp-preview(); Bridge.save-cam-rtmp-config(); }
                }
                SegDivider {}
                SegCell {
                    label: "Front";
                    active: Bridge.camera-idx == 0;
                    clicked => { Bridge.camera-idx = 0; Bridge.start-camera-rtmp-preview(); Bridge.save-cam-rtmp-config(); }
                }
            }
        }
    }
}
