// panel_host.slint — Geometry + visibility shell for full-screen overlay panels.
//
// Owns:
//   - safe-area inset math (reads SafeArea global directly)
//   - "is this panel currently active" visibility gating
//   - one conditional element per page
//
// Does NOT own:
//   - panel-specific wiring (close / save / cancel) — declared at the call-site
//     in MainWindow, but inside the host's content area so geometry stays uniform.
//
// Slint docs ref:
//   draft/slint-ui/docs/astro/src/content/docs/guide/language/coding/repetition-and-data-models.mdx

import { Panel } from "../bridge.slint";
import { PanelBridge } from "../state/panel_bridge.slint";
import { SafeArea } from "../state/safe_area.slint";
import { Theme } from "../theme.slint";

export component PanelHost inherits Rectangle {
    background: transparent;
    width: 100%;
    height: 100%;

    visible: PanelBridge.active != Panel.none;

    // Dark scrim background
    Rectangle {
        background: Theme.scrim-strong;
        
        TouchArea {
            clicked => { PanelBridge.close-all(); }
        }
    }

    // Centered card or bottom sheet card depending on portrait vs landscape.
    // Portrait: bottom sheet style
    // Landscape: centered dialog style
    Rectangle {
        x: parent.width > parent.height ? (parent.width - self.width) / 2 : 12px;
        y: parent.width > parent.height ? (parent.height - self.height) / 2 : parent.height - self.height - 12px;
        width: parent.width > parent.height ? parent.width * 0.7 : parent.width - 24px;
        height: parent.width > parent.height ? parent.height * 0.85 : parent.height * 0.8;
        background: Theme.surface-card.with-alpha(0.95);
        border-radius: Theme.radius-card * 2;
        border-width: 1px;
        border-color: Theme.text-disabled.with-alpha(0.25);
        drop-shadow-blur: Theme.elevation-3-blur;
        drop-shadow-color: Theme.scrim-strong;

        // Block touches propagating to scrim TouchArea
        TouchArea {}

        // Content area inside padding/rounded corners
        Rectangle {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            clip: true;
            border-radius: Theme.radius-card * 2;

            @children
        }
    }
}
