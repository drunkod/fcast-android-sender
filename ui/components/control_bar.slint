// control_bar.slint — Moblin-style portrait control bar.
//
// Layout (mirrors ControlBarPortraitView.swift):
//   HorizontalLayout:
//     LEFT  — horizontally-scrollable quick-action circles
//     RIGHT — fixed column: stream-state button (End / Connect / Cancel)
//
// QuickActionButton visual:
//   56×56 px circle, #000000bb bg, #555555 border, 18px icon + 9px label
//
// StreamStateButton visual:
//   72×40 px pill, color = state-dependent (red when live, blue when idle)

import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Bridge, QuickAction, QuickActionKind, Panel, AppState } from "../bridge.slint";
import { PanelBridge } from "../state/panel_bridge.slint";

// ── QuickActionButton ─────────────────────────────────────────────────────────
export component QuickActionButton inherits Rectangle {
    in property <QuickAction> action;
    callback invoked(QuickAction);

    pure function action-icon(kind: QuickActionKind) -> string {
        return kind == QuickActionKind.open-settings      ? "⚙️"
             : kind == QuickActionKind.open-audio         ? "🎧"
             : kind == QuickActionKind.open-camera        ? "📷"
             : kind == QuickActionKind.open-recording     ? "🔴"
             : kind == QuickActionKind.open-bitrate       ? "📊"
             : kind == QuickActionKind.open-network       ? "🌐"
             : kind == QuickActionKind.open-mixer         ? "🎛️"
             : kind == QuickActionKind.open-debug         ? "⚠️"
             : kind == QuickActionKind.open-cast-history  ? "📜"
             : kind == QuickActionKind.open-quick-actions ? "⋯"
             : kind == QuickActionKind.open-codec-test    ? "🧪"
             : kind == QuickActionKind.open-pairing       ? "📲"
             : kind == QuickActionKind.open-media-backend ? "⚡"
             : kind == QuickActionKind.start-record       ? "🔴"
             : kind == QuickActionKind.stop-record        ? "⏹️"
             : kind == QuickActionKind.run-macro          ? "▶️"
             : kind == QuickActionKind.scan-qr            ? "🔍"
             : "•";
    }

    height: 56px;
    width:  56px;

    border-radius: Theme.radius-circle;
    background: root.action.active ? Theme.accent-active.with-alpha(0.90)
              : ta.pressed         ? #ffffff22
              :                      #000000bb;
    border-width: 1px;
    border-color: #555555;

    opacity: root.action.enabled ? 1.0 : 0.45;

    accessible-role:    button;
    accessible-label:   root.action.title;
    accessible-enabled: root.action.enabled;
    accessible-checked: root.action.active;
    accessible-action-default => { if root.action.enabled { root.invoked(root.action); } }

    ta := TouchArea {
        enabled: root.action.enabled;
        clicked => { root.invoked(root.action); }
    }

    VerticalLayout {
        alignment: center;
        spacing: 2px;
        Text {
            text: action-icon(root.action.kind);
            color: #ffffff;
            font-size: 18px;
            horizontal-alignment: center;
        }
        Text {
            text: root.action.title;
            color: #ffffffcc;
            font-size: 9px;
            font-weight: 500;
            horizontal-alignment: center;
            overflow: elide;
        }
    }
}

// ── StreamStateButton ─────────────────────────────────────────────────────────
// Always-visible right-column button.  Mirrors Moblin's StreamButton.swift:
//   Casting        → red  pill  "● End"      → stops cast
//   WaitingForMedia→ red  pill  "Cancel"     → stops cast
//   Connecting / SelectingSettings → gray pill "…" (disabled)
//   Disconnected   → blue pill  "Connect"    → opens settings panel
component StreamStateButton inherits Rectangle {
    property <bool> is-live:    Bridge.app-state == AppState.Casting;
    property <bool> is-waiting: Bridge.app-state == AppState.WaitingForMedia;
    property <bool> is-active:  root.is-live || root.is-waiting;
    property <bool> is-busy:    Bridge.app-state == AppState.Connecting
                             || Bridge.app-state == AppState.SelectingSettings;

    height: 40px;
    width:  72px;
    border-radius: 10px;

    background: root.is-active ? Theme.error.with-alpha(0.92)
              : root.is-busy   ? #44444466
              :                  Theme.accent.with-alpha(0.80);
    border-width: 1px;
    border-color: root.is-active ? #ffffff55 : #555555;

    ta := TouchArea {
        enabled: !root.is-busy;
        clicked => {
            if (root.is-active) { Bridge.stop-casting(); }
            else { PanelBridge.push(Panel.settings); }
        }
    }

    HorizontalLayout {
        alignment: center;
        spacing: 4px;
        if root.is-live: Text {
            text: "●";
            color: #ff6060;
            font-size: 10px;
            vertical-alignment: center;
        }
        Text {
            text: root.is-live    ? @tr("End")
                : root.is-waiting ? @tr("Cancel")
                : root.is-busy    ? @tr("…")
                :                   @tr("Connect");
            color: #ffffff;
            font-size: 12px;
            font-weight: 700;
            vertical-alignment: center;
        }
    }
}

// ── CastControlBar ────────────────────────────────────────────────────────────
export component CastControlBar inherits Rectangle {
    height: Theme.control-bar-height;
    background: transparent;

    HorizontalLayout {
        padding-top:    (Theme.control-bar-height - 56px) / 2;
        padding-bottom: (Theme.control-bar-height - 56px) / 2;

        // LEFT: scrollable quick buttons — stop-cast excluded (handled by right column).
        ScrollView {
            horizontal-stretch: 1;
            mouse-drag-pan-enabled: true;
            vertical-scrollbar-policy:   ScrollBarPolicy.always-off;
            horizontal-scrollbar-policy: ScrollBarPolicy.as-needed;
            viewport-width:  actions-row.preferred-width;
            viewport-height: actions-row.preferred-height;

            actions-row := HorizontalLayout {
                padding-left: Theme.padding-screen;
                spacing: Theme.spacing-default;
                alignment: start;

                for action in Bridge.quick-actions: QuickActionButton {
                    action: action;
                    // stop-cast is handled by StreamStateButton in the right column.
                    visible: action.kind != QuickActionKind.stop-cast;
                    width:   action.kind != QuickActionKind.stop-cast ? 56px : 0;
                    height:  action.kind != QuickActionKind.stop-cast ? 56px : 0;
                    invoked(act) => {
                        if (act.kind == QuickActionKind.open-settings)    { PanelBridge.push(Panel.settings);        return; }
                        if (act.kind == QuickActionKind.open-debug)        { PanelBridge.push(Panel.debug);           return; }
                        if (act.kind == QuickActionKind.open-codec-test)   { PanelBridge.push(Panel.codec-test);      return; }
                        if (act.kind == QuickActionKind.open-recording)    { PanelBridge.push(Panel.recording);       return; }
                        if (act.kind == QuickActionKind.open-pairing)      { PanelBridge.push(Panel.pairing);         return; }
                        if (act.kind == QuickActionKind.open-bitrate)      { PanelBridge.push(Panel.bitrate-presets); return; }
                        if (act.kind == QuickActionKind.open-audio)        { PanelBridge.push(Panel.audio);           return; }
                        if (act.kind == QuickActionKind.open-camera)       { PanelBridge.push(Panel.camera);          return; }
                        if (act.kind == QuickActionKind.open-network)      { PanelBridge.push(Panel.network);         return; }
                        if (act.kind == QuickActionKind.open-mixer)        { PanelBridge.push(Panel.mixer);           return; }
                        if (act.kind == QuickActionKind.open-cast-history) { PanelBridge.push(Panel.cast-history);    return; }
                        if (act.kind == QuickActionKind.open-quick-actions){ PanelBridge.push(Panel.quick-actions);   return; }
                        if (act.kind == QuickActionKind.open-media-backend){ PanelBridge.push(Panel.media-backend);   return; }
                        if (act.kind == QuickActionKind.scan-qr)           { Bridge.invoke-action("scan-qr");         return; }
                        Bridge.invoke-action(act.custom-id);
                    }
                }
            }
        }

        // RIGHT: always-visible stream state button.
        VerticalLayout {
            width: 72px + Theme.padding-screen + Theme.spacing-default;
            alignment: center;
            padding-left:  Theme.spacing-default;
            padding-right: Theme.padding-screen;
            StreamStateButton { }
        }
    }
}
