// theme.slint — app token facade over slintcn colors plus app-specific tokens.
import { Tokens } from "slintcn/theme/tokens.slint";

export global Theme {
    // ── Surfaces ─────────────────────────────────────────────────────────
    out property <color> surface-primary:  transparent; // Transparent for camera preview
    out property <color> surface-black:    #000000;  // stealth overlay — intentional pure black
    out property <color> surface-card:     Tokens.color-card;
    out property <color> surface-bar:      Tokens.color-background;
    out property <color> surface-overlay:  #1f2937cc;
    // Scrim tokens used by dialogs / popovers / context menus.
    out property <color> scrim-strong:     #00000080;  // 50% black — modal blocking
    out property <color> scrim-light:      #00000040;  // 25% black — drop-shadow / soft

    // ── Text ─────────────────────────────────────────────────────────────
    out property <color> text-primary:     Tokens.color-foreground;
    out property <color> text-secondary:   Tokens.color-muted-foreground;
    out property <color> text-disabled:    Tokens.color-muted-foreground;
    out property <color> text-on-accent:   Tokens.color-primary-foreground;
    out property <color> text-on-error:    Tokens.color-primary-foreground;

    // ── Accent / interactive ──────────────────────────────────────────────
    out property <color> accent:           Tokens.color-primary;
    out property <color> accent-muted:     Tokens.color-muted;
    out property <color> accent-active:    Tokens.color-primary;
    out property <color> accent-pressed:   Tokens.color-primary;

    // ── Severity ─────────────────────────────────────────────────────────
    //
    // Each severity has paired tokens: a dark `*` (or `*-bg`) variant for use
    // as a *background* fill (e.g. DestructiveButton, StatusPill), and a
    // brighter `*-fg` variant for use as *text* color on dark surfaces (e.g.
    // Badge text inside StatusBadgesRow over surface-overlay).  The two roles
    // need different luminance to stay WCAG-AA legible — a single token
    // cannot serve both because a color readable as a 16px label on
    // surface-overlay is too bright to host white label text on top of it.
    out property <color> error:            Tokens.color-destructive;
    out property <color> error-fg:         #ef4444;   // fg/text (bright red)
    out property <color> warning:          #ed6c02;   // bg fill (dark amber)
    out property <color> warning-fg:       #ed6c02;   // fg/text (bright orange)
    out property <color> success:          #2e7d32;   // bg fill (dark green)
    // Paired token for the record button — avoids #cc0000 inline.
    out property <color> recording-dot:    #cc0000;

    // ── Typography — font sizes in pt (typographic points, 1pt = 4/3 px) ──
    out property <length> font-size-label:    9pt;
    out property <length> font-size-body:     12pt;
    out property <length> font-size-heading:  15pt;
    out property <length> font-size-icon:     11pt;  // icon badge symbol (was 14px)
    // Larger sizes used by overlays.
    out property <length> font-size-display:  36pt;  // lock icon (was 48px)
    out property <length> font-size-hero:     54pt;  // countdown number (was 72px)
    out property <length> font-size-cell:     15pt;  // history cell duration (was 20px)

    // ── Spacing ───────────────────────────────────────────────────────────
    out property <length> padding-screen:   12px;
    out property <length> padding-card:      8px;
    out property <length> spacing-default:   8px;
    out property <length> spacing-tight:     4px;
    out property <length> spacing-loose:    16px;

    // ── Shape ─────────────────────────────────────────────────────────────
    out property <length> radius-card:       8px;
    out property <length> radius-pill:        6px;
    out property <length> radius-circle:    9999px;
    out property <length> row-height:        48px;
    out property <length> row-height-comfortable: 56px;
    out property <length> row-height-compact:     40px;
    out property <length> control-bar-height: 72px;
    // Standard panel header height — used by every overlay.
    out property <length> header-height:    56px;
    // Asset sizing tokens.
    out property <length> thumbnail-width:  200px;
    out property <length> qr-square-min:    240px;
    out property <length> qr-square-max:    360px;

    // ── Icon badge backgrounds ────────────────────────────────────────────
    out property <color> icon-bg-neutral:  #374151;

    // ── Debug log level colors ────────────────────────────────────────────
    out property <color> log-trace:   #888888;
    out property <color> log-debug:   #4080ff;
    out property <color> log-info:    #20a020;
    out property <color> log-warning: #f0a020;
    out property <color> log-error:   #e02020;

    // ── Elevation ─────────────────────────────────────────────────────────
    // Drop-shadow tokens. Slint expresses elevation per-element with
    // `drop-shadow-blur` + `drop-shadow-color`.
    out property <length> elevation-1-blur:    4px;
    out property <length> elevation-2-blur:    8px;
    out property <length> elevation-3-blur:   16px;
}
