// debug_page.slint — Debug panel.


import { Bridge, Panel } from "../bridge.slint";
import { PanelBridge } from "../state/panel_bridge.slint";
import { Theme } from "../theme.slint";
import { PanelHeader } from "../components/panel_chrome.slint";

export component FullDebugPage inherits Rectangle {
    width: 100%;
    height: 100%;
    background: transparent;

    VerticalLayout {
        PanelHeader {
            title: @tr("Debug panel");
            close-clicked => { PanelBridge.pop(); }
        }

        VerticalLayout {
            padding: Theme.padding-screen;
            spacing: Theme.spacing-default;
            Text {
                horizontal-alignment: center;
                color: Theme.text-secondary;
                font-size: Theme.font-size-label;
                text: @tr("No debug actions available.");
            }
        }
    }
}
