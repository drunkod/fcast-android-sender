// settings_page.slint — Pre-cast quality selection screen (SettingsPageView)
// and the full Moblin-style settings overlay (FullSettingsPage).
//
// SettingsPageView: shown when AppState == SelectingSettings.
// FullSettingsPage: panel overlay reachable via PanelBridge.push(Panel.settings).

import { Spinner } from "std-widgets.slint";
import { Input } from "../slintcn/components/input.slint";
import { ScrollArea } from "../slintcn/components/scroll-area.slint";
import {
    Utils,
    VideoResolutionPicker,
    FrameratePicker,
} from "../components/mcore/common.slint";
import {
    Bridge,
    Panel,
    LifecycleMode,
    MediaBackendKind,
    AppState,
} from "../bridge.slint";
import { PanelBridge } from "../state/panel_bridge.slint";
import { Theme } from "../theme.slint";
import {
    PrimaryButton,
    DestructiveButton,
    TextButton,
} from "../components/buttons.slint";
import {
    SettingsSection,
    SettingsValueRow,
    SettingsToggleRow,
    SettingsTextRow,
    RowColors,
} from "../components/settings_rows.slint";
import { PanelHeader } from "../components/panel_chrome.slint";

export component SettingsPageView inherits Rectangle {
    property <int> video-resolution-idx: 2;
    property <int> video-framerate-idx: 2;

    VerticalLayout {
        padding: 8px;
        spacing: 8px;
        Text {
            font-size: Theme.font-size-body;
            vertical-alignment: center;
            text: @tr("Max resolution");
        }

        VideoResolutionPicker {
            current-index <=> video-resolution-idx;
        }

        Text {
            font-size: Theme.font-size-body;
            vertical-alignment: center;
            text: @tr("Max framerate");
        }

        FrameratePicker {
            current-index <=> video-framerate-idx;
        }

        PrimaryButton {
            label: @tr("start-cast-button" => "Start");
            clicked => {
                let scale = Utils.str-to-scale(video-resolution-idx);
                Bridge.start-casting(scale.width, scale.height, Utils.video-framerates[video-framerate-idx].to-float())
            }
        }

        DestructiveButton {
            label: @tr("Disconnect");
            clicked => {
                Bridge.stop-casting();
            }
        }
    }
}

export component FullSettingsPage inherits Rectangle {
    in-out property <int> resolution-idx: 2;
    in-out property <int> framerate-idx:  2;
    in-out property <bool> mdns-enabled:   true;

    width: 100%;
    height: 100%;
    background: transparent;

    VerticalLayout {
        // ── Header ────────────────────────────────────────────────────────────
        PanelHeader {
            title: @tr("Settings");
            close-clicked => {
                PanelBridge.pop();
            }
        }

        // ── Body (scrollable) ─────────────────────────────────────────────────
        ScrollArea {
            content-height: content.preferred-height;
            content := VerticalLayout {
                alignment: start;
                spacing: Theme.spacing-loose;
                padding: Theme.padding-screen;

                // ── Section: STREAM ───────────────────────────────────────────
                SettingsSection {
                    title: @tr("STREAM");
                    SettingsValueRow {
                        icon: "🪄";
                        icon-bg: Theme.icon-bg-neutral;
                        title: @tr("Stream Wizard");
                        value: @tr("Quick start via QR");
                        clicked => {
                            PanelBridge.push(Panel.rtmp-wizard);
                        }
                    }

                    SettingsValueRow {
                        icon: "📷";
                        icon-bg: Theme.icon-bg-neutral;
                        title: @tr("Camera");
                        value: @tr("open-panel-action" => "Open");
                        clicked => {
                            PanelBridge.push(Panel.camera);
                        }
                    }

                    SettingsValueRow {
                        icon: "🎧";
                        icon-bg: Theme.icon-bg-neutral;
                        title: @tr("Audio");
                        value: @tr("open-panel-action" => "Open");
                        clicked => {
                            PanelBridge.push(Panel.audio);
                        }
                    }

                    SettingsValueRow {
                        icon: "📊";
                        icon-bg: Theme.icon-bg-neutral;
                        title: @tr("Bitrate");
                        value: @tr("open-panel-action" => "Open");
                        clicked => {
                            PanelBridge.push(Panel.bitrate-presets);
                        }
                    }

                    SettingsValueRow {
                        icon: "🎛️";
                        icon-bg: Theme.icon-bg-neutral;
                        title: @tr("Mixer");
                        value: @tr("open-panel-action" => "Open");
                        clicked => {
                            PanelBridge.push(Panel.mixer);
                        }
                    }

                    SettingsValueRow {
                        icon: "🌐";
                        icon-bg: Theme.icon-bg-neutral;
                        title: @tr("Network");
                        value: @tr("open-panel-action" => "Open");
                        clicked => {
                            PanelBridge.push(Panel.network);
                        }
                    }

                    SettingsValueRow {
                        icon: "📡";
                        icon-bg: Theme.icon-bg-neutral;
                        title: @tr("Camera RTMP Stream");
                        value: @tr("open-panel-action" => "Open");
                        clicked => {
                            PanelBridge.push(Panel.camera-rtmp-stream);
                        }
                    }

                    SettingsValueRow {
                        icon: "🅡";
                        icon-bg: Theme.icon-bg-neutral;
                        title: @tr("RTMP Settings");
                        value: @tr("open-panel-action" => "Open");
                        clicked => {
                            PanelBridge.push(Panel.protocol-rtmp-settings);
                        }
                    }

                    SettingsValueRow {
                        icon: "🛰";
                        icon-bg: Theme.icon-bg-neutral;
                        title: @tr("SRT Stream");
                        value: @tr("open-panel-action" => "Open");
                        clicked => {
                            PanelBridge.push(Panel.protocol-srt-settings);
                        }
                    }

                    SettingsValueRow {
                        icon: "🎬";
                        icon-bg: Theme.icon-bg-neutral;
                        title: @tr("Scenes");
                        value: @tr("open-panel-action" => "Open");
                        clicked => {
                            PanelBridge.push(Panel.scene-list);
                        }
                    }

                    SettingsValueRow {
                        icon: "📺";
                        icon-bg: Theme.icon-bg-neutral;
                        title: @tr("Max resolution");
                        value: ["480p", "720p", "1080p", "1440p"][Math.clamp(root.resolution-idx, 0, 3)];
                        clicked => {
                            root.resolution-idx = Math.mod(root.resolution-idx + 1, 4);
                        }
                    }

                    SettingsValueRow {
                        icon: "⏱";
                        icon-bg: Theme.icon-bg-neutral;
                        title: @tr("Max framerate");
                        value: ["24 fps", "30 fps", "60 fps"][Math.clamp(root.framerate-idx, 0, 2)];
                        clicked => {
                            root.framerate-idx = Math.mod(root.framerate-idx + 1, 3);
                        }
                    }
                }

                // ── Section: RECEIVER ─────────────────────────────────────────
                SettingsSection {
                    title: @tr("RECEIVER");

                    // Device list shown only when disconnected.
                    if Bridge.app-state == AppState.Disconnected: VerticalLayout {
                        spacing: Theme.spacing-default;
                        padding-left: Theme.padding-screen;
                        padding-right: Theme.padding-screen;
                        padding-top: Theme.spacing-default;
                        padding-bottom: Theme.spacing-default;

                        if Bridge.devices.length == 0: Rectangle {
                            height: 64px;
                            border-radius: Theme.radius-card;
                            background: #ffffff0d;
                            HorizontalLayout {
                                alignment: center;
                                spacing: Theme.spacing-default;
                                Spinner {
                                    indeterminate: true;
                                    width: 20px;
                                    height: 20px;
                                }

                                Text {
                                    text: @tr("Searching for receivers…");
                                    color: Theme.text-secondary;
                                    font-size: Theme.font-size-body;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        if Bridge.devices.length > 0: VerticalLayout {
                            spacing: 1px;
                            for device in Bridge.devices: Rectangle {
                                height: Theme.row-height;
                                background: dev-ta.pressed ? RowColors.pressed : RowColors.normal;
                                dev-ta := TouchArea {
                                    clicked => {
                                        Bridge.connect-receiver(device.id);
                                        PanelBridge.pop();
                                    }
                                }

                                HorizontalLayout {
                                    padding-left: Theme.padding-screen;
                                    padding-right: Theme.padding-screen;
                                    alignment: center;
                                    spacing: Theme.spacing-default;
                                    Rectangle {
                                        width: 28px;
                                        height: 28px;
                                        border-radius: Theme.radius-pill;
                                        background: Theme.icon-bg-neutral;
                                        Text {
                                            text: "◉";
                                            font-size: Theme.font-size-icon;
                                            color: Theme.text-primary;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }

                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        alignment: center;
                                        Text {
                                            text: device.name;
                                            color: Theme.text-primary;
                                            font-size: Theme.font-size-body;
                                            overflow: elide;
                                        }

                                        Text {
                                            text: device.address;
                                            color: Theme.text-secondary;
                                            font-size: Theme.font-size-label;
                                            overflow: elide;
                                        }
                                    }

                                    Text {
                                        text: "›";
                                        color: Theme.text-secondary;
                                        font-size: Theme.font-size-heading;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        ip-field := Input {
                            placeholder: @tr("Receiver IP address");
                        }

                        PrimaryButton {
                            label: @tr("Connect");
                            enabled: ip-field.text != "";
                            clicked => {
                                Bridge.connect-receiver(ip-field.text);
                                PanelBridge.pop();
                            }
                        }
                    }

                    SettingsValueRow {
                        icon: "📲";
                        icon-bg: Theme.icon-bg-neutral;
                        title: @tr("Pair via QR");
                        clicked => {
                            PanelBridge.push(Panel.pairing);
                        }
                    }

                    SettingsToggleRow {
                        icon: "🌐";
                        icon-bg: Theme.icon-bg-neutral;
                        title: @tr("mDNS discovery");
                        checked: root.mdns-enabled;
                        toggled(checked) => {
                            root.mdns-enabled = checked;
                        }
                    }
                }

                // ── Section: RECORDING ────────────────────────────────────────
                SettingsSection {
                    title: @tr("RECORDING");
                    SettingsValueRow {
                        icon: "🔴";
                        icon-bg: Theme.icon-bg-neutral;
                        title: @tr("Recording");
                        value: @tr("open-panel-action" => "Open");
                        clicked => {
                            PanelBridge.push(Panel.recording);
                        }
                    }

                    SettingsValueRow {
                        icon: "📜";
                        icon-bg: Theme.icon-bg-neutral;
                        title: @tr("Cast history");
                        value: @tr("open-panel-action" => "Open");
                        clicked => {
                            PanelBridge.push(Panel.cast-history);
                        }
                    }
                }

                // ── Section: DISPLAY ──────────────────────────────────────────
                SettingsSection {
                    title: @tr("DISPLAY");
                    SettingsValueRow {
                        icon: "⋯";
                        icon-bg: Theme.icon-bg-neutral;
                        title: @tr("Quick actions");
                        value: @tr("open-panel-action" => "Open");
                        clicked => {
                            PanelBridge.push(Panel.quick-actions);
                        }
                    }
                }

                // ── Section: PRIVACY ──────────────────────────────────────────
                SettingsSection {
                    title: @tr("PRIVACY");
                    SettingsValueRow {
                        icon: "🔒";
                        icon-bg: Theme.icon-bg-neutral;
                        title: @tr("Lock UI");
                        value: @tr("Enter");
                        clicked => {
                            Bridge.engage-lock();
                        }
                    }

                    SettingsValueRow {
                        icon: "🕵️";
                        icon-bg: Theme.icon-bg-neutral;
                        title: @tr("Stealth mode");
                        value: @tr("Enter");
                        clicked => {
                            Bridge.engage-stealth();
                        }
                    }

                    SettingsValueRow {
                        icon: "⏱";
                        icon-bg: Theme.icon-bg-neutral;
                        title: @tr("Cast with countdown");
                        value: @tr("{}s", Bridge.snapshot-secs);
                        clicked => {
                            Bridge.start-snapshot-countdown(Bridge.snapshot-secs);
                        }
                    }
                }

                // ── Section: AUTOMATION ───────────────────────────────────────
                SettingsSection {
                    title: @tr("AUTOMATION");
                    SettingsValueRow {
                        icon: "▶️";
                        icon-bg: Theme.icon-bg-neutral;
                        title: @tr("Macros");
                        value: @tr("open-panel-action" => "Open");
                        clicked => {
                            PanelBridge.push(Panel.macros);
                        }
                    }
                }

                // ── Section: DEBUG ────────────────────────────────────────────
                SettingsSection {
                    title: @tr("DEBUG");
                    SettingsValueRow {
                        icon: "🧪";
                        icon-bg: Theme.icon-bg-neutral;
                        title: @tr("H.264 encoder test");
                        value: @tr("open-panel-action" => "Open");
                        clicked => {
                            PanelBridge.push(Panel.codec-test);
                        }
                    }

                    SettingsValueRow {
                        icon: "⚡";
                        icon-bg: Theme.icon-bg-neutral;
                        title: @tr("Codec performance test");
                        value: @tr("open-panel-action" => "Open");
                        clicked => {
                            PanelBridge.push(Panel.codec-perf);
                        }
                    }

                    SettingsValueRow {
                        icon: "📋";
                        icon-bg: Theme.icon-bg-neutral;
                        title: @tr("Debug log");
                        value: @tr("open-panel-action" => "Open");
                        clicked => {
                            PanelBridge.push(Panel.debug-log);
                        }
                    }

                    SettingsValueRow {
                        icon: "📽️";
                        icon-bg: Theme.icon-bg-neutral;
                        title: @tr("Video pipeline");
                        value: @tr("open-panel-action" => "Open");
                        clicked => {
                            PanelBridge.push(Panel.debug-video);
                        }
                    }

                    SettingsValueRow {
                        icon: "⚡";
                        icon-bg: Theme.icon-bg-neutral;
                        title: @tr("Media backend");
                        value: Bridge.media-backend == MediaBackendKind.migration ? @tr("Migration (in-process)") : @tr("gst-pop ({})", Bridge.gstpop-url);
                        clicked => {
                            PanelBridge.push(Panel.media-backend);
                        }
                    }

                    SettingsValueRow {
                        icon: "⚠️";
                        icon-bg: Theme.icon-bg-neutral;
                        title: @tr("Test functionality");
                        clicked => {
                            PanelBridge.push(Panel.test-functionality);
                        }
                    }
                }

                // ── Section: DATA ─────────────────────────────────────────────
                SettingsSection {
                    title: @tr("DATA");
                    SettingsValueRow {
                        icon: "🔄";
                        icon-bg: Theme.icon-bg-neutral;
                        title: @tr("Backup & reset");
                        value: @tr("open-panel-action" => "Open");
                        clicked => {
                            PanelBridge.push(Panel.backup-reset);
                        }
                    }
                }

                // ── Section: ABOUT ────────────────────────────────────────────
                SettingsSection {
                    title: @tr("ABOUT");
                    SettingsValueRow {
                        icon: "ℹ️";
                        icon-bg: Theme.icon-bg-neutral;
                        title: @tr("App version");
                        value: Bridge.app-version;
                        show-chevron: false;
                    }

                    SettingsValueRow {
                        icon: "🌐";
                        icon-bg: Theme.icon-bg-neutral;
                        title: @tr("FCast protocol");
                        value: "v3";
                        show-chevron: false;
                    }
                }
            }
        }
    }
}
